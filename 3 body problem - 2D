# this code is for a 2D version of the 3 body problem (may add a 3D version later)

import matplotlib.pyplot as plt
import numpy as np
from matplotlib.animation import FuncAnimation 

G = 6.67430e-11  # Gravitational constant
M_S = 1.989e30  # Mass of the Sun in kg

#mass of the three stars
M_1 = 0.5 * M_S  
M_2 = 1.0 * M_S  
M_3 = 2.0 * M_S  

# constants for physics calculations
K_1 = G * M_1  
K_2 = G * M_2  
K_3 = G * M_3  

# initial positions and velocities of the three stars
x_1 = 1.0e11  
y_1 = -1.0e11  
x_2 = 1.5e11  
y_2 = 1.0e11  
x_3 = 2.0e11  
y_3 = -1.0e11  

v_x1 = 0.0  
v_y1 = 30000.0  
v_x2 = 0.0  
v_y2 = 25000.0  
v_x3 = 20000.0
v_y3 =  100.0

# array to store the positions for plotting
x_plot1 = []
y_plot1 = []
x_plot2 = []
y_plot2 = []
x_plot3 = []
y_plot3 = []

# simulation parameters
change_t = 1000.0  
duration = 10000000 

# Physics calculation loop
for i in range(duration):
    r_12 = np.sqrt((x_2 - x_1) ** 2 + (y_2 - y_1) ** 2)
    r_13 = np.sqrt((x_3 - x_1) ** 2 + (y_3 - y_1) ** 2)
    r_23 = np.sqrt((x_3 - x_2) ** 2 + (y_3 - y_2) ** 2)

    
    ax1 = K_2 * (x_2 - x_1) / r_12 ** 3 + K_3 * (x_3 - x_1) / r_13 ** 3
    ay1 = K_2 * (y_2 - y_1) / r_12 ** 3 + K_3 * (y_3 - y_1) / r_13 ** 3
    
    ax2 = K_1 * (x_1 - x_2) / r_12 ** 3 + K_3 * (x_3 - x_2) / r_23 ** 3
    ay2 = K_1 * (y_1 - y_2) / r_12 ** 3 + K_3 * (y_3 - y_2) / r_23 ** 3
    
    ax3 = K_1 * (x_1 - x_3) / r_13 ** 3 + K_2 * (x_2 - x_3) / r_23 ** 3
    ay3 = K_1 * (y_1 - y_3) / r_13 ** 3 + K_2 * (y_2 - y_3) / r_23 ** 3

    v_x1 += ax1 * change_t
    v_y1 += ay1 * change_t
    v_x2 += ax2 * change_t
    v_y2 += ay2 * change_t
    v_x3 += ax3 * change_t
    v_y3 += ay3 * change_t

    x_1 += v_x1 * change_t
    y_1 += v_y1 * change_t 
    x_2 += v_x2 * change_t
    y_2 += v_y2 * change_t 
    x_3 += v_x3 * change_t
    y_3 += v_y3 * change_t 

    x_plot1.append(x_1)
    y_plot1.append(y_1)
    x_plot2.append(x_2)
    y_plot2.append(y_2)
    x_plot3.append(x_3)
    y_plot3.append(y_3)

# --- Animation Setup --- (used AI for help with this section)

fig, ax_plot = plt.subplots(figsize=(8, 8), facecolor='black')
ax_plot.set_facecolor('black')

trail1, = ax_plot.plot([], [], color='cyan', alpha=0.6, linewidth=1.5, label='Star 1 Path')
trail2, = ax_plot.plot([], [], color='orange', alpha=0.6, linewidth=1.5, label='Star 2 Path')
trail3, = ax_plot.plot([], [], color='magenta', alpha=0.6, linewidth=1.5, label='Star 3 Path')

# FIX 3: Configured the visual body radius relative to the new 1e11 spatial scale
# This guarantees they appear as prominent, beautifully zoomed-in circles
body_radius = 6.0e9  
star1 = plt.Circle((0, 0), body_radius, color='cyan', label='Star 1')
star2 = plt.Circle((0, 0), body_radius, color='orange', label='Star 2')
star3 = plt.Circle((0, 0), body_radius, color='magenta', label='Star 3')

ax_plot.add_patch(star1)
ax_plot.add_patch(star2)
ax_plot.add_patch(star3)

ax_plot.axis('off')
plt.title('Chaotic 3-Body Simulation', color='white', fontsize=14)
plt.legend(facecolor='black', edgecolor='white', labelcolor='white', loc='upper right')
plt.axis('equal')

# FRAME_STEP controls frame-skipping playback speed
FRAME_STEP = 50  

def update(frame):
    idx = frame * FRAME_STEP
    
    if idx >= len(x_plot1):
        idx = len(x_plot1) - 1
        
    trail1.set_data(x_plot1[:idx], y_plot1[:idx])
    trail2.set_data(x_plot2[:idx], y_plot2[:idx])
    trail3.set_data(x_plot3[:idx], y_plot3[:idx])
    
    star1.set_center((x_plot1[idx], y_plot1[idx]))
    star2.set_center((x_plot2[idx], y_plot2[idx]))
    star3.set_center((x_plot3[idx], y_plot3[idx]))
    
    # FIX 4: Dynamically auto-zoom on the specific bounding box containing the stars right now
    current_x = [x_plot1[idx], x_plot2[idx], x_plot3[idx]]
    current_y = [y_plot1[idx], y_plot2[idx], y_plot3[idx]]
    
    # Track the exact coordinate extremes of the current frame position
    min_x, max_x = min(current_x), max(current_x)
    min_y, max_y = min(current_y), max(current_y)
    
    # Calculate the current span width and height
    width = max_x - min_x
    height = max_y - min_y
    max_span = max(width, height)
    
    # If they are very close together, enforce a minimum zoom window so they don't clip outside
    if max_span < 5e10:
        max_span = 5e10
        
    center_x = sum(current_x) / 3
    center_y = sum(current_y) / 3
    
    # Set the camera view boundaries tightly centered on the stars
    zoom_radius = max_span * 0.75  # 25% padding buffer inside frame
    ax_plot.set_xlim(center_x - zoom_radius, center_x + zoom_radius)
    ax_plot.set_ylim(center_y - zoom_radius, center_y + zoom_radius)
    
    return trail1, trail2, trail3, star1, star2, star3

total_frames = len(x_plot1) // FRAME_STEP

# Set blit=False to allow fluid camera resizing adjustments
ani = FuncAnimation(fig, update, frames=total_frames, interval=25, blit=False)

plt.show()
