#ax_plot.set_xlim(-max_val_M, max_val_M)
#ax_plot.set_ylim(-max_val_M, max_val_M)
ax_plot.set_xlim(-max_val_R, max_val_R)
ax_plot.set_ylim(-max_val_R, max_val_R)

# 5. Define the update function for the animation
# 'frame' corresponds to the index of our x_plot/y_plot arrays
def update(frame):
    # To speed up the visualization, skip frames (step by 500)
    idx = frame * 500
    
    # Safety check to avoid index errors
    if idx >= len(x_plot_R):
        idx = len(x_plot_R) - 1
        
    # Update the historical trail line up to the current index
    trail_line.set_data(x_plot_R[:idx], y_plot_R[:idx])
    
    # Update the rocket's current exact circle position
    rocket_dot.set_data([x_plot_R[idx]], [y_plot_R[idx]])
    
    # Update the moon's current exact circle position
    moon_circle.set_center((x_plot_M[idx], y_plot_M[idx]))
    
    return trail_line, rocket_dot, moon_circle

# 6. Run the animation loop
# frames calculation ensures it plays from start to finish smoothly
total_frames = len(x_plot_R) // 500
ani = FuncAnimation(fig, update, frames=total_frames, interval=20, blit=True)

plt.show()
